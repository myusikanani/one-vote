# Server Port
PORT=5000

# OpenAI API Key (Optional for AI voice & staff chatbot features; offline fallback included)
OPENAI_API_KEY=your_openai_api_key_here

# Environment
NODE_ENV=development

# Hackathon Synthetic Demo Mode (Required for Demo Role Switching & Reset)
DEMO_MODE=true

# Demo JWT Secret for Role-Based Access Tokens
DEMO_JWT_SECRET=civic_hackathon_demo_secret_key_2026
