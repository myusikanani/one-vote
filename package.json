{
  "name": "one-vote",
  "version": "1.0.0",
  "description": "One Voter ID — Anywhere Voting Civic Hackathon Prototype",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "node test-backend.js",
    "tunnel": "node tunnel.js",
    "share": "node tunnel.js",
    "live": "concurrently \"node server/index.js\" \"node tunnel.js\""
  },
  "keywords": [
    "civic-tech",
    "voting",
    "hackathon",
    "accessibility",
    "decoupled-privacy"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2"
  }
}
